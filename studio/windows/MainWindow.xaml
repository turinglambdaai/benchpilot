<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Width="320">
            <TextBlock
                Text="Rivet"
                FontSize="32"
                FontWeight="SemiBold" />
            <TextBlock
                Text="Racket + WinUI 3"
                Opacity="0.65" />
            <InfoBar
                x:Name="StatusBar"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Message="Starting embedded Racket CS…" />
            <TextBlock
                x:Name="CountText"
                Text="Count: 0"
                FontSize="24" />
            <Button
                x:Name="IncrementButton"
                Content="Increment in Racket"
                IsEnabled="False"
                HorizontalAlignment="Stretch"
                Click="Increment_Click" />
        </StackPanel>
    </Grid>
</Window>
