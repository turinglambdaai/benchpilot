<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Text="BenchPilot Studio"
            FontSize="28"
            FontWeight="SemiBold" />
        <InfoBar
            Grid.Row="1"
            x:Name="StatusBar"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Message="Starting embedded Racket CS…" />
        <TextBlock
            Grid.Row="2"
            x:Name="InfoText"
            TextWrapping="Wrap"
            Opacity="0.85" />
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="PowerOnButton"
                Content="Power on"
                IsEnabled="False"
                Click="PowerOn_Click" />
            <Button
                x:Name="PowerOffButton"
                Content="Power off"
                IsEnabled="False"
                Click="PowerOff_Click" />
            <Button
                x:Name="DtcReadButton"
                Content="Read DTCs"
                IsEnabled="False"
                Click="DtcRead_Click" />
            <Button
                x:Name="RefreshButton"
                Content="Refresh"
                IsEnabled="False"
                Click="Refresh_Click" />
        </StackPanel>
        <TextBlock
            Grid.Row="4"
            x:Name="HistoryText"
            Text="Recent operations:"
            TextWrapping="Wrap"
            FontFamily="Consolas"
            Opacity="0.85" />
        <TextBlock
            Grid.Row="5"
            x:Name="DetailText"
            TextWrapping="Wrap"
            Opacity="0.65" />
    </Grid>
</Window>
