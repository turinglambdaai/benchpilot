{
  "schemaVersion": 1,
  "name": "Real ECU example",
  "defaultTarget": "ecu",
  "resources": {
    "psu.main": {
      "driver": "scpi-power",
      "capabilities": ["power"],
      "settings": {
        "host": "192.168.1.50",
        "port": 5025,
        "connectTimeoutMs": 3000,
        "ioTimeoutMs": 3000,
        "currentLimitA": 2.0,
        "setVoltage": "VOLT {voltage}",
        "setCurrentLimit": "CURR {current}",
        "outputOn": "OUTP ON",
        "outputOff": "OUTP OFF",
        "measureVoltage": "MEAS:VOLT?",
        "measureCurrent": "MEAS:CURR?"
      }
    },
    "uart.ecu": {
      "driver": "system-serial",
      "capabilities": ["serial"],
      "settings": {
        "port": "COM7",
        "baud": 115200,
        "newLine": "\n",
        "maxBufferedLines": 4096
      }
    },
    "probe.ecu": {
      "driver": "jlink",
      "capabilities": ["flash"],
      "settings": {
        "device": "CHANGE_ME_TO_SEGGER_DEVICE_NAME",
        "interface": "SWD",
        "speedKhz": 4000,
        "timeoutMs": 120000
      }
    }
  },
  "targets": {
    "ecu": {
      "name": "Example ECU",
      "mcu": "CHANGE_ME",
      "bindings": {
        "power": "psu.main",
        "serial": "uart.ecu",
        "flash": "probe.ecu"
      }
    }
  },
  "safety": {
    "maxVoltage": 14.5,
    "maxCurrentMa": 2500,
    "requireExplicitTarget": true,
    "requireDestructiveConfirmation": true
  }
}
