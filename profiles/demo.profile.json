{
  "schemaVersion": 1,
  "name": "BenchPilot simulator",
  "defaultTarget": "demo",
  "resources": {
    "sim.demo": {
      "driver": "simulator",
      "capabilities": ["power", "serial", "flash"],
      "settings": {
        "voltage": 12.0,
        "settleMs": 2000,
        "port": "SIM0",
        "baud": 115200,
        "firmware": "build/app.elf"
      }
    }
  },
  "targets": {
    "demo": {
      "name": "Demo ECU",
      "mcu": "simulated-mcu",
      "bindings": {
        "power": "sim.demo",
        "serial": "sim.demo",
        "flash": "sim.demo"
      }
    }
  },
  "safety": {
    "maxVoltage": 14.5,
    "maxCurrentMa": 2000,
    "requireExplicitTarget": false
  }
}
